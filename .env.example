# --- Database ---
DATABASE_URL=postgresql+asyncpg://kanoon_user:kanoon_pass@localhost:5432/kanoon_wala
SYNC_DATABASE_URL=postgresql+psycopg2://kanoon_user:kanoon_pass@localhost:5432/kanoon_wala

# --- Auth ---
JWT_SECRET_KEY=change-this-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- OTP delivery ---
# SMS_PROVIDER: dev (default, logs OTP instead of sending — good for local testing),
# twilio, or msg91. Pick one and fill in its section below.
SMS_PROVIDER=dev
OTP_EXPIRY_SECONDS=300

# Twilio (https://console.twilio.com)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# MSG91 (https://control.msg91.com) — often cheaper for Indian numbers
MSG91_AUTH_KEY=
MSG91_SENDER_ID=KANOON
MSG91_TEMPLATE_ID=

# --- LLM / RAG ---
ANTHROPIC_API_KEY=your-anthropic-key
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-mpnet-base-v2
LLM_MODEL=claude-sonnet-4-6

# --- Voice ---
WHISPER_MODEL_SIZE=small
TTS_VOICE_HI=hi-IN-SwaraNeural
TTS_VOICE_EN=en-IN-NeerjaNeural

# --- Storage ---
DOCUMENT_STORAGE_DIR=/data/user_documents
AUDIO_STORAGE_DIR=/data/audio
MEDIA_BASE_URL=http://localhost:8000/media

# --- App ---
APP_NAME=Kanoon Wala
ADMIN_BOOTSTRAP_PHONE=+91XXXXXXXXXX
ENV=development
